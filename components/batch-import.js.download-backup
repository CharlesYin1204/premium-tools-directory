'use client';
import {useState} from 'react';
import {Upload,Download} from 'lucide-react';
import {fields,defaults} from '../lib/catalog';
import {parseCsv} from '../lib/import-csv';
import {adminApi} from '../lib/admin-api';
export default function BatchImport({kind,resources,onDone}){
 const [open,setOpen]=useState(false),[parsed,setParsed]=useState(null),[mapping,setMapping]=useState({}),[error,setError]=useState(''),[busy,setBusy]=useState(false),[results,setResults]=useState([]);
 const specs=fields[kind]||[];
 async function read(file){setError('');setResults([]);setParsed(null);try{if(!file)return;if(file.size>1024*1024)throw Error('文件不能超过1MB');const p=parseCsv(await file.text());const m={};for(const [key,label]of specs){const alias={name:'页面显示名称',description:'页面可见介绍',target_url:'目标网址URL',icon_url:'Icon或图片URL',android_url:'APP下载链接'}[key];m[key]=p.headers.findIndex(h=>[key,label,alias].includes(h));}setMapping(m);setParsed(p);}catch(e){setError(e.message);}}
 function data(row){const d=defaults(kind);for(const [key,,type]of specs){const value=row[mapping[key]];if(value===undefined||value==='')continue;d[key]=['categories','tags','entries'].includes(type)?value.split(/[,，;]/).map(x=>x.trim()).filter(Boolean):type==='number'?Number(value):type==='checkbox'?['true','1','是'].includes(value):value.trim();}return d;}
 function problems(row){const d=data(row);return specs.filter(([key,,type,required])=>required&&(!d[key]||Array.isArray(d[key])&&!d[key].length)).map(([,label])=>label+'必填');}
 async function submit(){if(!parsed||busy||results.length)return;setBusy(true);setError('');const out=[];try{for(let i=0;i<parsed.rows.length;i++){const row=parsed.rows[i],missing=problems(row);if(missing.length){out.push({row:i+2,ok:false,message:missing.join('；')});}else{try{const saved=await adminApi('admin/'+kind,{action:'save',data:data(row)});out.push({row:i+2,ok:true,message:'草稿已保存',id:saved.id});}catch(e){out.push({row:i+2,ok:false,message:e.message});if(!e.status){setError('操作结果可能尚未确认，已停止后续导入，请刷新核对后再处理。');break;}}}setResults([...out]);}}finally{setBusy(false);onDone();}}
 function template(){const text='\uFEFF'+specs.map(([key])=>key).join(',')+'\r\n';const url=URL.createObjectURL(new Blob([text],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=kind+'-import-template.csv';a.click();URL.revokeObjectURL(url);}
 return <><button className="button" onClick={()=>setOpen(!open)} disabled={busy}><Upload size={16}/>批量导入</button>{open&&<section className="panel" style={{padding:20,position:'fixed',inset:'10% 5%',zIndex:100,overflow:'auto',background:'white',boxShadow:'0 8px 40px #0003'}}><div className="heading-actions"><h2>批量导入草稿</h2><button className="button" onClick={template}><Download size={16}/>下载CSV模板</button><button className="button" disabled={busy} onClick={()=>setOpen(false)}>关闭</button></div><input type="file" accept=".csv" aria-label="选择CSV文件" disabled={busy} onChange={e=>read(e.target.files[0])}/>{error&&<p role="alert">{error}</p>}{parsed&&<><div className="form-grid">{specs.map(([key,label])=><label key={key}>{label}<select value={mapping[key]??-1} disabled={busy||results.length>0} onChange={e=>setMapping({...mapping,[key]:Number(e.target.value)})}><option value={-1}>不导入此字段</option>{parsed.headers.map((h,i)=><option key={i} value={i}>{h}</option>)}</select></label>)}</div><p>共 {parsed.rows.length} 条，保存为草稿。渠道和分类使用后台已有记录的ID。</p><details><summary>查看渠道和分类ID</summary>{resources.filter(r=>['companies','categories'].includes(r.kind)).map(r=><p key={r.id}>{r.name}：{r.id}</p>)}</details><div className="table-wrap"><table><thead><tr><th>行号</th><th>名称</th><th>校验 / 导入结果</th></tr></thead><tbody>{parsed.rows.map((r,i)=><tr key={i}><td>{i+2}</td><td>{data(r).name}</td><td>{results.find(x=>x.row===i+2)?.message||problems(r).join('；')||'必填字段完整；保存时检查网址与重复项'}</td></tr>)}</tbody></table></div><button className="button primary" disabled={busy||results.length>0} onClick={submit}>{busy?'正在导入…':'确认保存为草稿'}</button>{results.length>0&&<p>成功 {results.filter(x=>x.ok).length} 条，失败 {results.filter(x=>!x.ok).length} 条。</p>}</>}</section>}</>;
}
