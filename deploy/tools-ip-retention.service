[Unit]
Description=Remove expired tool directory click IP identifiers
After=mysqld.service
[Service]
Type=oneshot
WorkingDirectory=/www/wwwroot/daohang
ExecStart=/opt/laosiji-runtime/node-v22.16.0-linux-x64/bin/node --env-file=.env.local scripts/purge-click-ips.mjs
User=www
Group=www
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
